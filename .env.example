PORT=3000
SPREADSHEET_ID=PEGAR_ID_DE_LA_PLANILLA_INVENTARIO_VICTOR
GOOGLE_CLIENT_EMAIL=PEGAR_EMAIL_DE_LA_CUENTA_DE_SERVICIO
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPEGAR_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Inicio de sesión con Google (OAuth / Google Identity Services)
# Crear un "ID de cliente OAuth 2.0" de tipo Aplicación web en Google Cloud.
GOOGLE_LOGIN_CLIENT_ID=PEGAR_CLIENT_ID.apps.googleusercontent.com
# Opcional. Dejar vacío para aceptar cuentas Gmail/personales y Workspace.
GOOGLE_LOGIN_DOMAIN=

# Opcionales. ALLOWED_ORIGINS acepta varios dominios separados por coma.
ALLOWED_ORIGINS=https://TU-APP.onrender.com



# Modo administrador
ADMIN_KEY=cambiar-por-una-clave-admin-segura
ADMIN_TOKEN_SECRET=cambiar-por-una-clave-larga-y-segura

# Usuario inicial que se crea automáticamente en la hoja Usuarios
ADMIN_USERNAME=admin

# Notificaciones push de vencimientos
VAPID_PUBLIC_KEY=PEGAR_CLAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=PEGAR_CLAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:administracion@autoserviciovictor.com
# Opcional: secreto para invocar /notificaciones/procesar desde un cron externo
NOTIFICATION_CRON_SECRET=cambiar-por-un-secreto-largo
# Producción: lista separada por comas. Ej.: https://tu-app.onrender.com
# Duración de sesión (1 a 30 días). V19.6 usa 7 por defecto.
USER_SESSION_DAYS=7
NODE_ENV=development

# Opcional: verificar/crear estructura de Horarios al iniciar el servidor.
AUTO_MIGRATE_SHEETS=false

# PostgreSQL (Etapas 1-3: Usuarios, Sectores y Horarios usan PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host:5432/base
# Opcionales: límites del pool de conexiones.
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
